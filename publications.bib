  title = {EMPNet: An Extract-Map-Predict neural network architecture for cross-domain recommendation},
  author = {Jinpeng Chen and Fan Zhang and Huan Li and Hua Lu and Xiongnan Jin and Kuien Liu and Hongjun Li and Yongheng Wang},
  year = {2024},
  journal = {World Wide Web Journal},
  doi = {10.1007/s11280-024-01240-z},
  keywords = {empnet; extract; map; predict; neural; network; architecture; cross; computer science; domain (mathematical analysis)},
  abstract = {This work designs a biased Attentional Factorization Machine (AFM) to utilize biases extracted from user and item features and experimentally evaluates EMPNet on the Amazon dataset, showing that it clearly outperforms the selected baselines.},
  url = {https://dblp.org/rec/journals/www/ChenZLLJLLW24}
}

